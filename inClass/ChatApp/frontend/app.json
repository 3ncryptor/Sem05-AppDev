{
  "expo": {
    "name": "ChatApp — Sem05 Messenger",
    "slug": "chatapp-sem05",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "chatapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "edu.rishihood.nst.chatapp",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSPhotoLibraryUsageDescription": "Allow ChatApp to attach and send Base64 images in conversations."
      }
    },
    "android": {
      "package": "edu.rishihood.nst.chatapp",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ChatApp to pick photos to send as Base64 images in chat."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}

